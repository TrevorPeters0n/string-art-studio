# Normalise to LF in the repository by default.
* text=auto eol=lf

# Windows script hosts need CRLF or they misbehave (wscript in particular
# will not parse a .vbs with bare LF line endings on some systems).
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf
*.vbs  text eol=crlf

# Never touch binaries.
*.png  binary
*.ico  binary

# Keep generated/vendored noise out of language stats and diffs.
assets/example.png linguist-generated=true
